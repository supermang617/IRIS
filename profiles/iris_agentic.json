{
  "name": "iris_agentic",
  "enabled": true,
  "startup_default": false,
  "activation": {
    "requires_explicit_user_session": true,
    "requires_absolute_workspace_path": true,
    "inactivity_timeout_minutes": 30,
    "expires_on_iris_exit": true,
    "expires_on_panic_stop": true,
    "expires_on_mode_change": true,
    "duplicate_sessions_allowed": false
  },
  "runtime": {
    "provider": "hermes_agent",
    "version": "0.16.0",
    "transport": "acp_stdio",
    "lifecycle_owner": "iris",
    "local_ollama_only": true,
    "cloud_fallback": false,
    "max_iterations": 8,
    "max_output_tokens_per_turn": 512,
    "native_durable_memory": false,
    "curator": false,
    "cron": false,
    "messaging": false,
    "updater": false
  },
  "workspace": {
    "selection": "single_user_selected_directory",
    "boundary": "advisory_unrestricted_powershell",
    "scope_expansion_requires_confirmation": true
  },
  "session_approved_tools": [
    "read_file",
    "write_file",
    "patch",
    "search_files",
    "terminal",
    "process",
    "browser_open",
    "browser_snapshot",
    "browser_click",
    "browser_fill",
    "browser_press",
    "browser_screenshot",
    "browser_get_url",
    "browser_upload",
    "browser_download",
    "browser_close"
  ],
  "currently_enabled_tools": [
    "iris_query_memory",
    "iris_propose_memory",
    "read_file",
    "write_file",
    "patch",
    "search_files",
    "terminal",
    "process",
    "browser_open",
    "browser_snapshot",
    "browser_click",
    "browser_fill",
    "browser_press",
    "browser_screenshot",
    "browser_get_url",
    "browser_upload",
    "browser_download",
    "browser_close"
  ],
  "currently_enabled_acting_tools": [
    "read_file",
    "write_file",
    "patch",
    "search_files",
    "terminal",
    "process",
    "browser_open",
    "browser_snapshot",
    "browser_click",
    "browser_fill",
    "browser_press",
    "browser_screenshot",
    "browser_get_url",
    "browser_upload",
    "browser_download",
    "browser_close"
  ],
  "always_confirm_risks": [
    "destructive_git",
    "install_or_admin",
    "credentials",
    "consequential_browser_submission",
    "executable_download",
    "payment",
    "sensitive_files",
    "scope_expansion"
  ],
  "memory": {
    "authority": "iris",
    "query_via_iris_bridge": true,
    "stage_via_iris_bridge": true,
    "direct_promotion": false,
    "tool_results_are_untrusted_evidence": true,
    "provenance_required": true
  }
}
